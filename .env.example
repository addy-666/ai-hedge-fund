# AI Fund OS — process settings (backend/src/aifund/config/settings.py). Secrets and host paths only.
# Copy to .env (git-ignored). Trading behaviour is configured in config/trading.yaml, not here.

BROKER=sim                          # sim | mt5
CONFIG_PATH=config/trading.yaml
DATABASE_URL=sqlite:///data/aifund.db

# --- DeepSeek
DEEPSEEK_API_KEY=

# --- MetaTrader 5 (all three required when BROKER=mt5; the engine never trades an implicit account)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=                           # e.g. C:\aifund\mt5\terminal64.exe (empty = default install)
MT5_PORTABLE=false

# --- Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEALTHCHECKS_URL=

# --- API / dashboard
API_SECRET_KEY=
ADMIN_PASSWORD_HASH=                # argon2 hash: cd backend && uv run python scripts/hash_password.py
API_COOKIE_SECURE=true              # keep true (tailscale serve gives HTTPS); false only for plain-http local tests
API_ALLOWED_ORIGINS=                # CORS, comma-separated; empty = same origin only (the API serves the dashboard)
