# --- DEEPSEEK LLM CONFIGURATION ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- METATRADER 5 CONFIGURATION ---
# Replace with your Exness/Vantage account details
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=Exness-MT5Trial7
# Leave empty to auto-detect MT5 installation path
MT5_PATH=

# --- RISK & ENGINE CONFIGURATION ---
DEFAULT_RISK_PERCENT=1.0
SCAN_INTERVAL_SECONDS=30
CONFIDENCE_THRESHOLD=65
SYMBOLS=XAUUSDm,EURUSDm,US100m,BTCUSDm,USOILm

# --- SELF-LEARNING AUDITOR CONFIGURATION ---
AUDIT_TRADE_THRESHOLD=10
AUDIT_COOLDOWN_HOURS=12

# --- OBSIDIAN VAULT PATH ---
# Absolute path to your Trading Brain vault for RAG knowledge
VAULT_PATH=/Users/anubrata/Desktop/TRADING OS/TRADING BRAIN/wiki
